# Flowork environment template
# Copy to .env (gitignored) and fill in real values.
# Compose substitutes ${VAR} from this file for postgres/app passwords.

# ─── Single-server listener settings ───
# Loopback is the safe default: reach the Web UI through an SSH port forward.
# Set VIBECANVAS_BIND_ADDRESS to one specific private/LAN IP only when direct
# IP access is intentional. It controls only the Web entry point.
VIBECANVAS_BIND_ADDRESS=127.0.0.1
# API diagnostics, databases, authorization, queues, and metrics remain on a
# separate loopback binding. Change this only for an explicitly protected
# private operations network; never expose it to the Internet or a shared VNet.
VIBECANVAS_INTERNAL_BIND_ADDRESS=127.0.0.1
VIBECANVAS_HTTP_PORT=9001
VIBECANVAS_API_PORT=8000
VIBECANVAS_POSTGRES_PORT=5432
VIBECANVAS_REDIS_PORT=6379
VIBECANVAS_OPENFGA_PORT=8080
VIBECANVAS_OPENFGA_METRICS_PORT=2112
VIBECANVAS_WORKER_METRICS_PORT=9100
# Optional private API origin used by sandbox Runtimes for Platform MCP and the
# model broker. Leave blank for the normal installers: Docker Compose injects
# http://api:8000, while the native launcher uses its loopback API.
PLATFORM_MCP_INTERNAL_BASE_URL=

# ─── Knowledge Base ───
# Knowledge is Agent-native: encrypted files are parsed/chunked locally, then
# discovered through catalog/list/grep/read tools. It has no embedding model,
# vector extension, or provider API key.

# ─── Database roles ───
# Runtime is RLS-bound and owns no schema objects. The one-shot migrator owns
# schema objects; maintenance is non-superuser/BYPASSRLS without DDL.
POSTGRES_PASSWORD=dev
VIBECANVAS_APP_PASSWORD=vc_app
VIBECANVAS_MIGRATOR_PASSWORD=vc_migrator
VIBECANVAS_MAINTENANCE_PASSWORD=vc_maintenance
OPENFGA_POSTGRES_PASSWORD=
# Dedicated least-privilege credential used only to remove identity-bearing
# OpenFGA change-feed rows during irreversible account erasure.
OPENFGA_ERASURE_PASSWORD=

# ─── Frontend ───
# Empty default = same-origin (nginx reverse-proxies /api/ to api container).
# For prod with cross-origin api (e.g., web on CDN, api on api.example.com), set:
#   VITE_API_BASE=https://api.example.com
VITE_API_BASE=

# Canonical browser-visible application URL. For the local-server installer,
# prefer `--public-url`: the launcher writes this value and derives the normal
# Host, CORS, cookie, and extension settings below. Use HTTPS outside local
# development.
VIBECANVAS_PUBLIC_URL=https://workspace.example.com
# Domain is optional. Development/WSL examples:
#   http://192.168.1.20:9001
#   http://[2001:db8::20]:9001
# Production may use an HTTPS IP origin such as https://203.0.113.20:9001.
# Advanced override for deployments with more than one public entry. The local
# server launcher derives the canonical host from VIBECANVAS_PUBLIC_URL. Accepts
# host names, IP literals, host:port, or complete HTTP(S) origins; ports are
# ignored here because Host authorization validates the hostname. Use
# comma-separated exact entries, never `true` or `*`.
WEB_ALLOWED_HOSTS=
# Advanced override for additional exact browser Origins. The local server
# launcher derives the canonical Origin from VIBECANVAS_PUBLIC_URL.
# If Vite runs alongside Docker, include both exact browser origins, for example:
# VIBECANVAS_API_CORS_ORIGINS=http://localhost:9001,http://localhost:5173
# Recreate the API container after changing this value; a restart retains its old environment.
VIBECANVAS_API_CORS_ORIGINS=
# Comma-separated networks of the TLS/reverse proxies allowed to supply
# X-Forwarded-For. Direct clients outside these CIDRs cannot spoof audit IPs.
TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
# Actual HTTP bytes accepted before parsing. Keep above the largest allowed
# upload plus multipart overhead; webhook invocation remains capped at 1 MiB.
VIBECANVAS_HTTP_REQUEST_MAX_BYTES=54525952
# Production API/workers must leave DDL to the one-shot migration workload.
RUN_DATABASE_MIGRATIONS=false

# OpenFGA production control plane. Keep API, workers, bootstrap validation,
# and rollout tooling on this one immutable pin. Development Compose provisions
# its own store/model; production never auto-creates or selects "latest".
OPENFGA_API_URL=
OPENFGA_API_TOKEN=
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_MODEL_SHA256=
OPENFGA_TIMEOUT_SECONDS=2
# Required on custom deployments that enable OpenFGA and account deletion.
# The role must only execute public.flowork_erase_changelog; Docker Compose
# provisions it automatically from OPENFGA_ERASURE_PASSWORD.
OPENFGA_ERASURE_DATABASE_URL=

# Browser authentication. Production requires both controls: the main browser
# receives only a Secure/HttpOnly Session cookie, while the extension redeems a
# short-lived single-use code for its own audience-bound partitioned cookie.
WEB_SESSION_COOKIE_ENABLED=true
# The local server launcher derives this from the public URL scheme. Set false
# only for direct localhost/private-IP HTTP development. Production always
# forces Secure __Host- cookies regardless of this value.
WEB_SESSION_COOKIE_SECURE=
EXTENSION_SCOPED_TOKEN_ENABLED=true
DISTRIBUTED_AUTH_RATE_LIMIT_ENABLED=true
# Account erasure defaults to irreversible immediate deletion. Delayed mode
# locks access now and permits password-confirmed cancellation until the
# retention boundary; accepted retention is 1-365 days.
ACCOUNT_DELETION_MODE=immediate
ACCOUNT_DELETION_RETENTION_DAYS=14
# Keep enabled anywhere Celery Beat and the maintenance queue worker run.
PURGE_WORKER_ENABLED=true
# Production must set this true only after encrypted backup and restore-
# suppression procedures have been verified operationally.
BACKUP_ENCRYPTION_VERIFIED=false
# Company OIDC SSO login is an optional capability. When false, the login tab
# is hidden and all public SSO login endpoints fail closed.
ENTERPRISE_SSO_ENABLED=false
# Shared test account is development-only and must stay off in production.
ENABLE_TEST_USER=false
# Optional privileged-support control plane. It remains completely unavailable
# unless explicitly enabled with at least two distinct user UUIDs. Every
# request/approval/activation still requires a recent WebAuthn ceremony.
PRIVILEGED_ACCESS_ENABLED=false
PRIVILEGED_SUPPORT_OPERATOR_IDS=
# One published extension identity shared by API token/Origin validation, Web
# postMessage peers, and nginx `/embed` frame-ancestors. Do not configure these
# layers independently.
VIBECANVAS_BROWSER_EXTENSION_ID=mkfldhmlgdbpmhplaphhcfcdcoaakcik
# Advanced extension build overrides. The local server launcher derives both
# from VIBECANVAS_PUBLIC_URL. Values may be domain, IPv4, or bracketed IPv6
# HTTP(S) origins with ports and may include a fixed reverse-proxy prefix.
VIBECANVAS_EXTENSION_WEB_BASE=
VIBECANVAS_EXTENSION_ALLOWED_ORIGINS=
# Independent stable HMAC key used only for 15-minute browser-WS capabilities.
BROWSER_TOKEN_SECRET=
# Stable HMAC key for signed Preview/VFS URLs. Generate independently from all
# encryption keys so URL revocation/rotation does not rotate stored content.
VIBECANVAS_SIGNING_SECRET=

# Envelope-encryption KMS. Production should use aws-kms with workload identity.
# Do not inject AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY into production workloads.
# Local compose may use `local` with one stable urlsafe-base64 32-byte key.
# Generate independently:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
KMS_PROVIDER=local
KMS_KEY_ID=vibecanvas-local-development
KMS_WORKLOAD_IDENTITY=
KMS_LOCAL_MASTER_KEY=
KMS_LOCAL_MASTER_KEY_FILE=
CONTENT_LOOKUP_HMAC_KEY=
CONTENT_LOOKUP_HMAC_KEY_FILE=

# Migration-only Fernet key for installations upgrading from the retired OAuth
# ciphertext format. New OAuth/MCP credentials use SecretService envelope
# encryption, but an existing installation must keep its original value until
# the strict migration has completed.
OAUTH_ENCRYPTION_KEY=

# Production SMTP resolves this AWS Secrets Manager reference just in time.
# SMTP_PASSWORD is accepted only in development/test and forbidden in prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD_SECRET_ID=

# ─── Optional: agent LLM gateway ───
# A fresh installation has no implicit/default model. Configure a platform API
# with VIBECANVAS_DEFAULT_AGENT_API, or let each user add a credential in
# Settings. AGENT_API_KEY remains a legacy config.yaml supplement.
VIBECANVAS_DEFAULT_AGENT_API=
AGENT_API_KEY=
# Optional hard override: ignore every platform default API source (including
# legacy config.yaml values). User-saved APIs and explicit Codex account/API
# connections remain available.
VIBECANVAS_DISABLE_PLATFORM_DEFAULT_API=0
# Sandbox Runtimes never receive AGENT_API_KEY. They use this short-lived
# Chat/Turn-bound capability against the host Runtime Model Broker instead.
# Range: 60..86400 seconds; default: 7200.
RUNTIME_MODEL_CAPABILITY_TTL_S=7200
# Model API egress: host (default, permits HTTP/private/localhost/WSL through
# host networking) or public_https (opt-in public HTTPS + DNS pinning).
RUNTIME_MODEL_EGRESS_POLICY=host

# Deployment-level Agent Runtime policy. Both values are comma-separated
# allowlists enforced by the API and reflected by Settings UI.
AGENT_RUNTIME_TYPES=codex
CODEX_RUNTIME_AUTH_METHODS=chatgpt,managed_api,personal_api
# Optional operator-managed Codex API profiles. Users see only name/model and
# store only the selected profile id; base_url/api_key remain process secrets.
# Keep the real JSON in a secret manager or mode-0600 .env, never in Git.
CODEX_MANAGED_APIS_JSON=[]
# Optional override. Compose pins this to a private named volume; native launch
# defaults to ~/.vibecanvas/agent-runtime so account login survives restarts.
AGENT_RUNTIME_ROOT=
# Legacy plaintext Chat Runtime root used only as an automatic migration source.
# New SQLite/JSONL/AGENTS.md state is encrypted in OBJECT_STORE_PROVIDER and is
# materialized into a private 0700 temporary POSIX directory only while active.
# After verifying migration, leave this blank on fresh deployments.
VFS_VOLUME_ROOT=

# ─── Object store ───
# Three providers:
#   inmemory   — process-local dict. ONLY correct single-process: a blob put
#                by the api is invisible to the celery_worker, so KB indexing
#                and batch download break across containers. Tests / single-proc only.
#   filesystem — encrypted VCOBJ2 blobs under OBJECT_STORE_FS_ROOT. The durable
#                volume spans backend processes; only sandboxd materializes and
#                mounts VFS plaintext projections. DEFAULT for single-node dev.
#   s3         — production object storage (AWS S3 / MinIO / vendor).
# For prod set:
#   OBJECT_STORE_PROVIDER=s3
#   S3_ENDPOINT_URL=https://s3.amazonaws.com   # blank for AWS, set for MinIO/vendors
#   S3_BUCKET=vibecanvas-prod
#   S3_REGION=us-east-1
# Production uses workload identity; static S3 access/secret keys are rejected.
OBJECT_STORE_PROVIDER=filesystem
# Shared directory for the filesystem provider. In compose this is the mount
# point of the object_store_data volume on backend services and sandboxd.
OBJECT_STORE_FS_ROOT=/var/lib/vibecanvas/objectstore
# Host-only plaintext materializations used while a sandbox is alive. Keep this
# off shared durable volumes; every process receives a private 0700 subfolder.
OBJECT_STORE_MATERIALIZED_ROOT=/tmp/vibecanvas-materialized
# Authenticated random-access block size. 256 KiB keeps Preview Range reads
# cheap while preserving high sequential throughput.
OBJECT_STORE_ENCRYPTION_CHUNK_BYTES=262144

# Optional self-hosted `/mount` bridge. This is a root directory only; the
# application creates `users/<stable-user-uuid>/` below it and binds only that
# user's directory at `/mount`. Host and VFS changes reconcile every second.
# The host mirror is intentionally plaintext so ordinary Linux tools can cp/mv
# files. The canonical VFS/object-store copy remains encrypted; use a dedicated
# mode-0700 directory on a trusted encrypted disk.
MOUNT_PATH=
MOUNT_SYNC_INTERVAL_SECONDS=1.0

# ─── CodeNode execution sandbox ───
# Library overlay root (content-addressed 3rd-party libs declared in Workflow
# Settings). sandboxd resolves/binds the prepared layer. Single-node Compose
# shares the cache; a remote sandbox node needs its own cache/build service.
LIB_OVERLAY_ROOT=/var/lib/vibecanvas/lib-overlay
# Path to the runsc (gVisor) binary. Execution is sandbox-only (no in-process
# fallback), so this MUST resolve in sandboxd. API/worker never launch runsc.
# The api/Dockerfile shared by sandboxd installs it at /usr/local/bin/runsc.
RUNSC_PATH=/usr/local/bin/runsc
# Independent Sandbox Service. Embedded mode is for isolated unit tests only.
# Local Compose uses a private shared UDS volume; cross-node mode must use
# grpcs:// plus a CA and workload client certificate/key.
SANDBOX_SERVICE_MODE=service
SANDBOX_SERVICE_SOCKET=/run/vibecanvas-sandbox/sandboxd.sock
SANDBOX_SERVICE_ENDPOINT=
SANDBOX_SERVICE_CA_FILE=
SANDBOX_SERVICE_CERT_FILE=
SANDBOX_SERVICE_KEY_FILE=
SANDBOX_SERVICE_CONNECT_TIMEOUT_S=5
# Unary deployment jobs; interactive execution uses the streaming RPC.
SANDBOX_SERVICE_OPERATION_TIMEOUT_S=86400
# Native launch gate: verify the credential-free base gVisor/Python file-op
# runtime before API/worker startup. Disable only for targeted diagnostics.
SANDBOX_PREWARM_ON_START=1
# Sandbox egress transport: "host-network" gives active Agent Runtimes direct
# protocol-compatible egress (development/trusted hosts). "proxy" keeps each
# sandbox network-none and relays HTTP(S)/WebSocket traffic through the shared
# egress-controller implementation (recommended for production).
SANDBOX_EGRESS_MODE=proxy
# One public-destination policy for every sandbox workload and lifecycle:
#   public        any public IP after DNS-rebinding/private-address checks
#   allowlist     only SANDBOX_EGRESS_ALLOW_HOSTS plus job-declared hosts
#   platform-only no public egress; internal Platform MCP/model proxy still works
SANDBOX_EGRESS_POLICY=public
# Comma-separated exact hosts or leading-dot suffixes, used by allowlist policy.
SANDBOX_EGRESS_ALLOW_HOSTS=
# Optional trusted private/intranet HTTP(S) endpoints as exact host:port pairs.
# The Platform MCP/model origin is added automatically and need not appear here.
SANDBOX_EGRESS_PRIVATE_TARGETS=
# Optional synthetic DNS CIDRs for advanced proxy environments. Keep empty for
# normal DNS. This never permits requests to literal private IPs.
SANDBOX_EGRESS_TRUSTED_PROXY_CIDRS=
# Optional outbound proxy for host-side catalog and metadata requests. This is
# separate from sandbox egress and is never inferred from HTTP_PROXY. Docker
# Desktop example: http://host.docker.internal:7897
FLOWORK_CONTROL_PLANE_HTTP_PROXY=
# Rootful snapshots cannot preserve gVisor hostinet state. This controls the
# credential-free file/workflow worker that is checkpointed. The active Agent
# Runtime and its sandbox-local MCP gateways are stopped before hibernation;
# all live sandbox egress follows the policy above.
SANDBOX_NETWORK=none
# One selector owns privilege and lifecycle. Rootful snapshot mode requires
# sandboxd (and only sandboxd) to run as uid 0.
SANDBOX_TYPE=rootful-snapshot
# gVisor execution platform. ptrace is the portable Docker baseline and works
# under Docker Desktop/WSL2. On a native Linux host, opt into systrap only after
# the startup capability probe succeeds on that kernel/seccomp profile.
SANDBOX_GVISOR_PLATFORM=ptrace
# Interactive state durations for both Chat and Workflow-page Run/Node Debug.
# In rootful-snapshot mode a warm session hibernates after five idle minutes,
# then its disk snapshot is released after another 30. Explicit UI close skips
# both timers and releases immediately.
SANDBOX_WARM_IDLE_TTL_S=300
SANDBOX_SNAPSHOT_IDLE_TTL_S=1800
# sandboxd observation cadence. The sandbox publishes positive activity/idle
# facts; it does not own or decrement a TTL countdown.
SANDBOX_ACTIVITY_POLL_INTERVAL_S=5
# Credential-free baseline retention for one-shot background Workflow runs.
SANDBOX_WORKFLOW_SNAPSHOT_TTL_S=86400
SANDBOX_SNAPSHOT_ROOT=/var/lib/vibecanvas/snapshots
SANDBOX_SNAPSHOT_READY_TIMEOUT_S=120
SANDBOX_SNAPSHOT_CHECKPOINT_TIMEOUT_S=120
SANDBOX_SNAPSHOT_RESTORE_TIMEOUT_S=120
# none is fastest and enables background/direct-I/O restore optimizations.
SANDBOX_SNAPSHOT_COMPRESSION=none
SANDBOX_SNAPSHOT_MAX_COUNT=128
SANDBOX_SNAPSHOT_MAX_BYTES=21474836480
# Includes system, Runtime and writable OCI mounts; startup fails above the cap.
SANDBOX_MAX_MOUNTS=24

# ─── Observability (Phase 8) ───
# App-owned flags read by ObservabilityConfig. The OTEL_* vars are consumed
# natively by the OpenTelemetry SDK, not by our config. Compose passes all of
# these through to the api + worker via env_file.
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json (prod) | console (local dev)
METRICS_ENABLED=true
OTEL_TRACES_ENABLED=false       # set true + an endpoint below to export traces
OTEL_EXPORTER_OTLP_ENDPOINT=    # e.g. http://tempo:4318 (Grafana/Datadog/local collector)
OTEL_SERVICE_NAME=vibecanvas-api
# Browser side-panel: seconds to retain a lost browser lease while waiting for
# the extension to reconnect and reconcile its persisted session snapshot.
BROWSER_LOST_GRACE_SECONDS=30
# Parallel-column envelope encryption for Chat/Workflow private content.
# Enable only after migration 067 and KMS configuration are ready.

# Production Object Store encryption-at-rest (SSE-KMS).
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=

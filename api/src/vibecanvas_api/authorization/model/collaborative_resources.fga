module collaborative_resources

type workflow
  relations
    define organization: [organization]
    define viewer: [user, group#direct_member, group#member, organization#member]
    define editor: [user, group#direct_member, group#member, organization#member]
    define operator: [user, service_account, group#direct_member, group#member, organization#member]
    define manager: [user, group#direct_member, group#member, organization#member]
    define can_view_metadata: viewer or editor or operator or manager or can_administer from organization or can_view_audit from organization
    define can_view: viewer or editor or operator or manager
    define can_export: viewer or editor or operator or manager
    define can_update: editor or manager
    define can_delete: manager or can_administer from organization
    define can_manage_access: manager or can_administer from organization
    define can_use: viewer or editor or operator or manager
    define can_execute: operator or manager
    define can_cancel: operator or manager
    define can_inspect_runs: operator or manager
    define can_deploy: manager
    define can_mount: viewer or editor or operator or manager

type task
  relations
    define organization: [organization]
    define viewer: [user, group#direct_member, group#member, organization#member]
    define editor: [user, group#direct_member, group#member, organization#member]
    define operator: [user, service_account, group#direct_member, group#member, organization#member]
    define manager: [user, group#direct_member, group#member, organization#member]
    define can_view_metadata: viewer or editor or operator or manager or can_administer from organization or can_view_audit from organization
    define can_view: viewer or editor or operator or manager
    define can_export: viewer or editor or operator or manager
    define can_update: editor or manager
    define can_delete: manager or can_administer from organization
    define can_manage_access: manager or can_administer from organization
    define can_execute: operator or manager
    define can_cancel: operator or manager
    define can_resume: operator or manager
    define can_inspect_runs: viewer or editor or operator or manager


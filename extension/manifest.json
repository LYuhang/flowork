{
  "key": "",
  "manifest_version": 3,
  "name": "Flowork Browser Automation",
  "version": "0.3.0",
  "description": "Holds a tenant-scoped WebSocket channel to the Flowork backend for browser automation.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flowork — open side panel",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["island/content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "permissions": ["offscreen", "sidePanel", "storage", "debugger", "tabs", "scripting", "downloads", "clipboardWrite"],
  "externally_connectable": {
    "matches": []
  }
}

{
  "name": "web",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm run lint:deployment-paths",
    "build:analyze": "ANALYZE=1 tsc -b && ANALYZE=1 vite build && pnpm run lint:deployment-paths",
    "lint": "eslint .",
    "lint:visual": "node scripts/audit-visual-system.mjs",
    "lint:routes": "node scripts/audit-route-inventory.mjs",
    "lint:locales": "node --test scripts/audit-locale-keys.test.mjs && node scripts/audit-locales.mjs && node scripts/audit-locale-keys.mjs && node scripts/audit-i18n-copy.mjs && node scripts/audit-i18n-surface-inventory.mjs && tsx --tsconfig tsconfig.app.json scripts/audit-locale-formatting.ts",
    "lint:retired-ui": "node scripts/audit-retired-ui.mjs",
    "lint:bundle": "node scripts/audit-bundle-budget.mjs",
    "lint:deployment-paths": "node scripts/audit-deployment-paths.mjs",
    "test:deployment-prefix": "node scripts/smoke-deployment-prefix.mjs",
    "test:visual-review": "node scripts/screenshots.mjs",
    "test:deep-interaction": "node scripts/deep-interaction-review.mjs",
    "preview": "vite preview",
    "test": "node scripts/run-vitest.mjs",
    "test:i18n:components": "node scripts/run-i18n-component-tests.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:i18n": "VIBECANVAS_I18N_MATRIX=1 playwright test e2e/41-i18n-complete-coverage.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "codegen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/api/schema.d.ts",
    "codegen:api:offline": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "codegen:snapshot": "curl -sf http://localhost:8000/openapi.json -o openapi.json && pnpm codegen:api:offline"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.3",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@file-viewer/react": "2.3.0",
    "@file-viewer/renderer-spreadsheet": "2.3.2",
    "@hookform/resolvers": "5.2.2",
    "@microsoft/fetch-event-source": "2.0.1",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.100.10",
    "@uiw/react-codemirror": "4.25.10",
    "@xyflow/react": "12.10.2",
    "ag-grid-community": "36.0.2",
    "ag-grid-react": "36.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dagre": "0.8.5",
    "exceljs": "4.4.0",
    "i18next": "26.1.0",
    "lucide-react": "1.14.0",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "pako": "2.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-diff-viewer-continued": "4.2.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.75.0",
    "react-i18next": "17.0.7",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.11.1",
    "react-router": "8.3.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dagre": "0.7.54",
    "@types/node": "24.12.4",
    "@types/pako": "2.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "10.5.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.25",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "fast-uri": "3.1.5",
      "js-yaml@4": "4.3.2",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}

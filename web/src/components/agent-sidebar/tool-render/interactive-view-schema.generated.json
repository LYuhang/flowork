{
  "$defs": {
    "FilePreviewView": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "file_type": {
          "default": "auto",
          "description": "Optional file-type hint passed unchanged to Preview. Use 'auto' unless the file has no reliable extension or MIME metadata.",
          "maxLength": 64,
          "minLength": 1,
          "title": "File Type",
          "type": "string"
        },
        "path": {
          "description": "Absolute local file path returned by a file tool. The Preview service detects the file type and selects the appropriate read-only renderer.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "const": "file_preview",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "title": "FilePreviewView",
      "type": "object"
    },
    "HtmlPreviewView": {
      "additionalProperties": false,
      "properties": {
        "html": {
          "description": "A complete HTML fragment or document. Self-contained inline JavaScript/CSS plus data:, blob:, and referenced local VFS files may be used. External scripts and network subresources are blocked; save a required remote asset into VFS first. Local files use the same absolute paths available to the Agent.",
          "minLength": 1,
          "title": "Html",
          "type": "string"
        },
        "type": {
          "const": "html_preview",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "html"
      ],
      "title": "HtmlPreviewView",
      "type": "object"
    },
    "UrlPreviewView": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "url_preview",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "Absolute HTTP(S) page URL opened in an isolated interactive WebView. No domain allowlist is applied; the destination may still refuse browser embedding.",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "UrlPreviewView",
      "type": "object"
    },
    "WorkflowPreviewView": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "workflow_preview",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "pattern": "^v[1-9]\\d*\\.sv\\d+$",
          "title": "Version",
          "type": "string"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "workflow_id",
        "version"
      ],
      "title": "WorkflowPreviewView",
      "type": "object"
    }
  },
  "discriminator": {
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/HtmlPreviewView"
    },
    {
      "$ref": "#/$defs/FilePreviewView"
    },
    {
      "$ref": "#/$defs/UrlPreviewView"
    },
    {
      "$ref": "#/$defs/WorkflowPreviewView"
    }
  ]
}
